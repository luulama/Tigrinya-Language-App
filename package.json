{
  "name": "polyglot-core",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run prepare:preview",
    "dev": "npm run dev --workspace @polyglot/web",
    "prebuild": "npm run prepare:preview",
    "build": "npm run build --workspace @polyglot/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare:preview": "python3 scripts/prepare_web_preview.py",
    "dev:api": "node scripts/dev-database.mjs",
    "test:postgres": "node scripts/test-postgres.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "embedded-postgres": "16.16.0-beta.19",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "type": "module"
}
