{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tigrinya:platform:1",
  "title": "Language platform exchange contracts",
  "$defs": {
    "LanguagePack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "languageTag": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "scriptModel": {
          "type": "string",
          "enum": [
            "alphabet",
            "abugida",
            "syllabary",
            "mixed",
            "other"
          ]
        },
        "normalisation": {
          "const": "NFC"
        },
        "segmentationAdapter": {
          "type": "string",
          "minLength": 1
        },
        "searchAdapter": {
          "type": "string",
          "minLength": 1
        },
        "answerAdapter": {
          "type": "string",
          "minLength": 1
        },
        "fontFamilies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "contentReleaseId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "languageTag",
        "script",
        "direction",
        "scriptModel",
        "normalisation",
        "segmentationAdapter",
        "searchAdapter",
        "answerAdapter",
        "fontFamilies",
        "contentReleaseId"
      ]
    },
    "Word": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "senseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "lexemeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "transliteration": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "pronunciationConvention": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "variety": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "register": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        },
        "audioVersionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "imageVersionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "script",
        "senseId",
        "lexemeId",
        "transliteration",
        "pronunciationConvention",
        "meaning",
        "variety",
        "register",
        "sourceIds",
        "audioVersionId",
        "imageVersionId"
      ]
    },
    "Phrase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "functionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "wordVersionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0
        },
        "register": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        }
      },
      "required": [
        "script",
        "meaning",
        "functionId",
        "wordVersionIds",
        "register",
        "sourceIds"
      ]
    },
    "Sentence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "patternVersionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        }
      },
      "required": [
        "script",
        "meaning",
        "context",
        "patternVersionIds",
        "sourceIds"
      ]
    },
    "Form": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "familyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "order": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "audioVersionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "strokeVersionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        }
      },
      "required": [
        "script",
        "familyId",
        "order",
        "audioVersionId",
        "strokeVersionId",
        "sourceIds"
      ]
    },
    "Grammar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "functionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "exampleVersionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        }
      },
      "required": [
        "functionId",
        "explanation",
        "exampleVersionIds",
        "sourceIds"
      ]
    },
    "Segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "audioVersionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "imageVersionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetVersionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "text",
        "audioVersionId",
        "imageVersionId",
        "targetVersionIds"
      ]
    },
    "Story": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "genre": {
          "type": "string",
          "enum": [
            "picture_story",
            "early_reader",
            "graded_reader",
            "chapter_story",
            "native_story",
            "article",
            "news",
            "podcast",
            "audiobook"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "P",
            "B",
            "E",
            "I",
            "U",
            "A",
            "R"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "minItems": 1
        },
        "introducedTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0
        },
        "recycledTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        },
        "ageBands": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "4-8",
              "9-12",
              "13-18",
              "adult"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "title",
        "genre",
        "stage",
        "segments",
        "introducedTargets",
        "recycledTargets",
        "sourceIds",
        "ageBands"
      ]
    },
    "Turn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "sentenceVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "audioVersionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "role",
        "sentenceVersionId",
        "audioVersionId"
      ]
    },
    "Dialogue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Turn"
          },
          "minItems": 2
        },
        "functionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        },
        "acceptableResponseVersionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        }
      },
      "required": [
        "purpose",
        "roles",
        "turns",
        "functionIds",
        "acceptableResponseVersionIds"
      ]
    },
    "Activity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "model",
            "contrast",
            "retrieval",
            "production",
            "communication",
            "recap",
            "transfer"
          ]
        },
        "promptVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "targetVersionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        },
        "responseMode": {
          "type": "string",
          "enum": [
            "tap",
            "point",
            "speak",
            "write",
            "type",
            "accessible_alternative"
          ]
        },
        "acceptedVersionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0
        },
        "requiresAudio": {
          "type": "boolean"
        },
        "requiresVerifiedStrokes": {
          "type": "boolean"
        },
        "modelBeforeAnswer": {
          "type": "boolean"
        },
        "accessibleAlternativeId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "promptVersionId",
        "targetVersionIds",
        "responseMode",
        "acceptedVersionIds",
        "requiresAudio",
        "requiresVerifiedStrokes",
        "modelBeforeAnswer",
        "accessibleAlternativeId"
      ]
    },
    "Lesson": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objectiveId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "stage": {
          "type": "string",
          "enum": [
            "P",
            "B",
            "E",
            "I",
            "U",
            "A",
            "R"
          ]
        },
        "prerequisiteObjectiveIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Activity"
          },
          "minItems": 1
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "requiredScopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "language",
              "teaching",
              "rights",
              "accessibility",
              "audio",
              "culture",
              "strokes"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "objectiveId",
        "stage",
        "prerequisiteObjectiveIds",
        "activities",
        "estimatedMinutes",
        "requiredScopes"
      ]
    },
    "Audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetType": {
          "const": "audio"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rightsSourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "altText": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "transcriptVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "variety": {
          "type": "string",
          "minLength": 1
        },
        "speakerKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "assetType",
        "path",
        "sha256",
        "rightsSourceId",
        "altText",
        "durationMs",
        "transcriptVersionId",
        "variety",
        "speakerKey"
      ]
    },
    "Image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetType": {
          "const": "image"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rightsSourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "altText": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "assetType",
        "path",
        "sha256",
        "rightsSourceId",
        "altText"
      ]
    },
    "Video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetType": {
          "const": "video"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rightsSourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "altText": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "transcriptVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "variety": {
          "type": "string",
          "minLength": 1
        },
        "captionsPath": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "assetType",
        "path",
        "sha256",
        "rightsSourceId",
        "altText",
        "durationMs",
        "transcriptVersionId",
        "variety",
        "captionsPath"
      ]
    },
    "Assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objectiveId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "skill": {
          "type": "string",
          "enum": [
            "visual",
            "listening",
            "speaking",
            "reading",
            "writing"
          ]
        },
        "parallelSetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "promptVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "acceptedVersionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0
        },
        "rubricDimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "requiresHumanAssessor": {
          "type": "boolean"
        },
        "modelBeforeAnswer": {
          "const": false
        }
      },
      "required": [
        "objectiveId",
        "skill",
        "parallelSetId",
        "promptVersionId",
        "acceptedVersionIds",
        "rubricDimensions",
        "requiresHumanAssessor",
        "modelBeforeAnswer"
      ]
    },
    "Culture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "community": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "perspective": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 1
        },
        "targetVersionIds": {
