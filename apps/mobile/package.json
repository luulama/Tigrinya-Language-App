{
  "name": "@polyglot/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node ../../node_modules/@playwright/test/cli.js test --config playwright.config.mjs",
    "typecheck": "tsc --noEmit",
    "ios:prepare": "node scripts/ios.mjs prepare",
    "ios:open": "node scripts/ios.mjs open",
    "ios:build": "node scripts/ios.mjs build",
    "ios:build:device": "node scripts/ios.mjs build-device",
    "ios:typecheck": "node scripts/swift-check.mjs",
    "ios:doctor": "node scripts/doctor.mjs",
    "ios:install-runtime": "node scripts/install-runtime.mjs",
    "release:check": "node scripts/check.mjs --release",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "typescript": "7.0.2"
  }
}
